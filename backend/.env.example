PORT=5000
# Comma-separated list -- renite-app and renite-admin usually run on
# different ports in dev (e.g. 5173 and 5174) and different subdomains
# in production, and both need to be listed here.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Service-role key (server-side only, NEVER exposed to the frontend).
# Find both under Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
